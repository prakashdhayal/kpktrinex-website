---
/** The closing band on a page: how to reach us - a call, WhatsApp or the contact page. */
import { CONTACT } from '../data/company';
import ExternalLink from './ExternalLink.astro';

interface Props {
  title?: string;
  text?: string;
}

const { title = 'Have something to build?', text = 'Tell us what you need. Call us, or send a message on WhatsApp.' } = Astro.props;
---

<div class="cta">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="actions">
    <ExternalLink class="btn primary" href={CONTACT.whatsapp} arrow={false}>WhatsApp us</ExternalLink>
    <a class="btn ghost" href={CONTACT.phoneHref}>Call {CONTACT.phone}</a>
  </div>
</div>
