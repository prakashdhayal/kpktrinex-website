---
/**
 * A link that leaves this website (a product's own site, WhatsApp, a client's site): it opens in a new tab, keeps this
 * page open, and says so to screen readers. Links within the site, phone and email links stay plain <a>.
 */
interface Props {
  href: string;
  class?: string;
  /** Show the ↗ after the words (default yes). */
  arrow?: boolean;
}

const { href, class: className, arrow = true } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener"><slot />{arrow && <span aria-hidden="true"> ↗</span>}<span class="sr-only"> (opens in a new tab)</span></a>
