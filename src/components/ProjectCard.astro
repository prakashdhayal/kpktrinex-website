---
/** A client project in a list: its picture, the client, what was built, and a link to the project's page. */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { client, title, summary, kind, image } = project.data;
---

<article class="card">
  {image && (
    <Picture class="shot" src={image.src} alt={image.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 700]}
      sizes="(max-width: 700px) calc(100vw - 88px), 360px" loading="lazy" />
  )}
  <span class="pill">{kind}</span>
  <h3>{title}</h3>
  <p><strong>{client}</strong> - {summary}</p>
  <a class="more" href={`/work/${project.id}/`}>See the project →</a>
</article>
