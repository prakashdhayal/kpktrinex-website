---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import ProductRow from '../../components/ProductRow.astro';
import { COMPANY } from '../../data/company';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Products of ${COMPANY.name}`,
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.name, url: `${COMPANY.site}/products/${p.id}/` })),
};
---

<Base
  title="Products"
  pageType="CollectionPage"
  crumbs={[{ name: 'Products', href: '/products/' }]}
  description={`Software products made and run by ${COMPANY.name}, Rajasthan: ${products.map((p) => `${p.data.name}, ${p.data.tagline.toLowerCase()}`).join('; ')}.`}
  jsonLd={[list]}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Products</span>
      <h1>What we make and run</h1>
      <p class="lead">Software we build, host and keep improving ourselves. Each product has its own website, where you can see it and ask for a demo.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      {products.map((p) => <ProductRow product={p} level={2} />)}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap"><ContactBand title="Want to see a product?" text="Call or message us and we'll show it to you." /></div>
  </section>
</Base>
