---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { COMPANY } from '../../data/company';

export async function getStaticPaths() {
  return (await getCollection('products')).map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { name, tagline, summary, url, audience, highlights, screens, seoTitle, seoDescription, shareImage } = product.data;
const { Content } = await render(product);

const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description: summary,
  url,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (web browser)',
  featureList: highlights.map((h) => h.title),
  ...(screens[0] ? { screenshot: new URL(screens[0].src.src, COMPANY.site).href } : {}),
  publisher: { '@id': `${COMPANY.site}/#organization` },
};
---

<Base
  title={name}
  fullTitle={seoTitle}
  description={seoDescription}
  crumbs={[{ name: 'Products', href: '/products/' }, { name, href: `/products/${product.id}/` }]}
  image={shareImage ? { src: shareImage, width: 1200, height: 630, alt: `${name} - ${tagline}` } : undefined}
  jsonLd={[software]}
>
  <section class="hero">
    <div class="wrap split">
      <div>
        <span class="eyebrow">A product of {COMPANY.name}</span>
        <h1>{name}</h1>
        <p class="lead">{tagline}. {summary}</p>
        <div class="actions">
          <ExternalLink class="btn primary" href={url}>Visit {name}</ExternalLink>
          <a class="btn ghost" href="/contact/">Ask for a demo</a>
        </div>
      </div>
      {screens[0] && (
        <figure class="shot">
          <Picture src={screens[0].src} alt={screens[0].alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 760, 1100]}
            sizes="(max-width: 860px) calc(100vw - 40px), 540px" loading="eager" fetchpriority="high" />
        </figure>
      )}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>What {name} does</h2>
      <p class="lead spaced">For {audience.charAt(0).toLowerCase() + audience.slice(1)}</p>
      <div class="grid">
        {highlights.map((h) => (
          <div class="card">
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class={screens.length > 1 ? 'wrap split' : 'wrap'}>
      {screens.length > 1 && (
        <figure class="shot">
          <Picture src={screens[1].src} alt={screens[1].alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 760, 1100]}
            sizes="(max-width: 860px) calc(100vw - 40px), 540px" loading="lazy" />
          <figcaption>{screens[1].alt}</figcaption>
        </figure>
      )}
      <div class="prose">
        <h2>Who makes it</h2>
        <Content />
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap"><ContactBand title={`See ${name} for yourself`} text="Visit its website, or call us for a demo." /></div>
  </section>
</Base>
