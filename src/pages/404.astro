---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This page isn't here</h1>
      <p class="lead">It may have moved, or the address may have a typo.</p>
      <div class="actions">
        <a class="btn primary" href="/">Go to the home page</a>
        <a class="btn ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>
