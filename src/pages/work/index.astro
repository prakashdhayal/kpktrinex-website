---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { COMPANY } from '../../data/company';

const projects = (await getCollection('projects')).sort((a, b) => b.data.delivered.valueOf() - a.data.delivered.valueOf());
---

<Base
  title="Work"
  pageType="CollectionPage"
  crumbs={[{ name: 'Work', href: '/work/' }]}
  description={`Websites and software ${COMPANY.name} has built and delivered for clients in Rajasthan and beyond - each shown with the client's agreement and a link to it.`}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Work</span>
      <h1>Built for our clients</h1>
      <p class="lead">Websites and software we have delivered. Each is shown with the client's agreement - open it and see it working.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      {projects.length > 0 ? (
        <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      ) : (
        <div class="empty">
          <p>Our first client websites are being built now. Each one will be listed here, with a link to it, once it is live and the client agrees.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap"><ContactBand /></div>
  </section>
</Base>
