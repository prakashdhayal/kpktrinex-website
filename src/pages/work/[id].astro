---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import ExternalLink from '../../components/ExternalLink.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { client, title, summary, url, kind, delivered, place, built, image } = project.data;
const { Content } = await render(project);
const deliveredOn = delivered.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---

<Base
  title={`${title} for ${client}`}
  description={`${title} for ${client}: ${summary}`.slice(0, 160)}
  crumbs={[{ name: 'Work', href: '/work/' }, { name: client, href: `/work/${project.id}/` }]}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">{kind}</span>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <div class="actions">
        <ExternalLink class="btn primary" href={url}>Visit the {kind.toLowerCase()}</ExternalLink>
        <a class="btn ghost" href="/work/">All work</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap split">
      <div>
        <dl class="facts">
          <div><dt>Client</dt><dd>{client}</dd></div>
          {place && <div><dt>Where</dt><dd>{place}</dd></div>}
          <div><dt>Delivered</dt><dd>{deliveredOn}</dd></div>
          {built.length > 0 && <div><dt>What we built</dt><dd>{built.join(' · ')}</dd></div>}
        </dl>
        <div class="prose"><Content /></div>
      </div>
      {image && (
        <figure class="shot">
          <Picture src={image.src} alt={image.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 760, 1100]}
            sizes="(max-width: 860px) calc(100vw - 40px), 540px" loading="eager" fetchpriority="high" />
        </figure>
      )}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap"><ContactBand title="Want something like this?" /></div>
  </section>
</Base>
