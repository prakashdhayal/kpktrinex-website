---
/**
 * Every page: its title and description, the canonical address and share card, structured data for search engines
 * (the company on every page; the website on the home page; the page itself and its breadcrumb trail on the rest), the
 * header with a menu that works without JavaScript on a phone, breadcrumbs, and the footer with the registered name,
 * address and Udyam number - the same on every page, as Meta and search engines check them.
 */
import '../styles/global.css';
import ExternalLink from '../components/ExternalLink.astro';
import { ADDRESS, COMPANY, CONTACT, NAV } from '../data/company';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** The whole <title> when the page's own is better than "Title | Company" (the home page, a product). */
  fullTitle?: string;
  /** The share card (public/, 1200 x 630 best); the company's card when not given. */
  image?: { src: string; width: number; height: number; alt: string };
  /** schema.org type of the page itself (AboutPage, ContactPage, CollectionPage...). */
  pageType?: string;
  /** The trail above this page (Home is added first); shown under the header and given to search engines. */
  crumbs?: Crumb[];
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Extra structured data for this page (a product). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, image, pageType = 'WebPage', crumbs, noindex = false, jsonLd = [] } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const canonical = new URL(path, Astro.site).href;
const fullTitle = Astro.props.fullTitle ?? `${title} | ${COMPANY.name}`;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const share = image ?? { src: '/og-card.jpg', width: 1200, height: 630, alt: `${COMPANY.name} - ${COMPANY.slogan}` };
const shareUrl = new URL(share.src, COMPANY.site).href;
const ORG = `${COMPANY.site}/#organization`;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG,
  name: COMPANY.name,
  legalName: COMPANY.legalName,
  slogan: COMPANY.slogan,
  description: `${COMPANY.name} is a software company in Rajasthan, India: it makes and runs its own products, starting with KPK Schools, and builds websites and software for clients.`,
  url: `${COMPANY.site}/`,
  logo: { '@type': 'ImageObject', url: `${COMPANY.site}/icon-512.png`, width: 512, height: 512 },
  image: `${COMPANY.site}/og-card.jpg`,
  email: CONTACT.email,
  telephone: CONTACT.phone,
  foundingDate: COMPANY.businessSince,
  founder: { '@type': 'Person', name: COMPANY.founder },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.locality,
    addressRegion: ADDRESS.region,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.country,
  },
  areaServed: { '@type': 'Country', name: 'India' },
  knowsAbout: ['Software development', 'Website development', 'School management software', 'Web applications', 'Software support and maintenance'],
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', telephone: CONTACT.phone, email: CONTACT.email, areaServed: 'IN', availableLanguage: ['English', 'Hindi'] }],
  identifier: { '@type': 'PropertyValue', propertyID: 'Udyam Registration Number', value: COMPANY.udyam },
};
const trail = crumbs ? [{ name: 'Home', href: '/' }, ...crumbs] : [];
const pageData = isHome
  ? { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${COMPANY.site}/#website`, name: COMPANY.name, url: `${COMPANY.site}/`, inLanguage: 'en-IN', publisher: { '@id': ORG } }
  : {
      '@context': 'https://schema.org',
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: 'en-IN',
      isPartOf: { '@id': `${COMPANY.site}/#website` },
      about: { '@id': ORG },
      ...(trail.length > 1 ? {
        breadcrumb: {
          '@type': 'BreadcrumbList',
          itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, COMPANY.site).href })),
        },
      } : {}),
    };
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/work-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b1f44" />
    <meta name="author" content={COMPANY.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageData)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${COMPANY.name} - home`}>
          <img src="/favicon.svg" alt="" width="38" height="38" />
          <span class="wordmark"><strong>KPK</strong> Trinex Technologies</span>
        </a>
        <nav class="nav wide" aria-label="Main">
          {NAV.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="menu">
          <summary aria-label="Open the menu"><span aria-hidden="true" class="burger"></span><span class="menu-word">Menu</span></summary>
          <nav class="nav" aria-label="Menu">
            <a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
            {NAV.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
            <a class="menu-call" href={CONTACT.phoneHref}>Call {CONTACT.phone}</a>
          </nav>
        </details>
      </div>
    </header>

    {trail.length > 1 && (
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <ol>
          {trail.map((c, i) => (
            <li>{i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <span class="mark"><img src="/favicon.svg" alt="" width="30" height="30" /></span>
            <p class="name">{COMPANY.name}</p>
            <p class="slogan">{COMPANY.slogan}</p>
            <address>
              {ADDRESS.lines.map((line) => <>{line}<br /></>)}
            </address>
          </div>
          <nav aria-label="Company">
            <h2>Company</h2>
            <ul>
              {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <div>
            <h2>Contact</h2>
            <ul>
              <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
              <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
              <li><ExternalLink href={CONTACT.whatsapp}>WhatsApp</ExternalLink></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {year} {COMPANY.name} · Udyam Registration No. {COMPANY.udyam}</span>
          <span><a href="/privacy-policy/">Privacy policy</a> · <a href="/terms/">Terms of use</a></span>
        </div>
      </div>
    </footer>

    <script>
      // the phone menu (a <details>) closes on Escape, a tap outside it, or a tap on one of its links
      const menu = document.querySelector<HTMLDetailsElement>('details.menu');
      if (menu) {
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
        document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
      }
    </script>
  </body>
</html>
